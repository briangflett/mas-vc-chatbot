# Firecrawl API key (for web scraping masadvise.org into KB)
FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# OpenAI API key (for generating embeddings)
OPENAI_API_KEY=your-openai-api-key-here

# PostgreSQL connection (Azure Flexible Server - klaus database)
PGHOST=mas-n8n-postgress-db.postgres.database.azure.com
PGPORT=5432
PGDATABASE=klaus
PGUSER=your-postgres-username-here
PGPASSWORD=your-postgres-password-here
PGSSLMODE=require
