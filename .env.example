# ── MAS VC Chatbot — environment (authoritative template) ──────────────────
# .env.local is git-ignored. In dev it is symlinked to Klaus's .env.local, which
# already provides the PG* + OPENAI_API_KEY values below.

# ── Azure PostgreSQL (shared "klaus" DB — read KB, write conversations) ──────
PGHOST=mas-n8n-postgress-db.postgres.database.azure.com
PGPORT=5432
PGDATABASE=klaus
PGUSER=your-postgres-username-here
PGPASSWORD=your-postgres-password-here
PGSSLMODE=require

# ── Embeddings (must match the model used to ingest kb_chunks) ───────────────
OPENAI_API_KEY=your-openai-api-key-here

# ── Chat model provider ──────────────────────────────────────────────────────
# LLM_PROVIDER: "anthropic" (default) or "openrouter".
# The live n8n stream ran anthropic/claude-haiku-4.5 via OpenRouter; the default
# here is Anthropic-direct Haiku 4.5 (CHAT_MODEL overrides).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# CHAT_MODEL=claude-haiku-4-5           # anthropic id; or anthropic/claude-haiku-4.5 for openrouter
# CHAT_MAX_TOKENS=4096
# CHAT_MAX_STEPS=10

# ── CiviCRM API4 service account (from the n8n "CiviCRM Custom Auth" cred) ────
# These are the X-Civi-Auth (APIv4 user key) and X-Civi-Key (site key) values.
CIVICRM_BASE_URL=https://www.masadvise.org
CIVICRM_API_KEY=your-civicrm-api-key-here
CIVICRM_SITE_KEY=your-civicrm-site-key-here

# ── CORS: the WordPress origin allowed to call /api/chat ─────────────────────
ALLOWED_ORIGIN=https://www.masadvise.org

# ── KB ingestion only (scripts/ingest-kb.ts) ────────────────────────────────
# FIRECRAWL_API_KEY=your-firecrawl-api-key-here
